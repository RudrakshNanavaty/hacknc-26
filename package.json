{
  "name": "reefforge",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "shared",
    "app",
    "server"
  ],
  "scripts": {
    "build": "bun run --filter @reef/app build",
    "start": "bun run --filter @reef/server start",
    "dev": "bun run --filter @reef/app --filter @reef/server --parallel dev",
    "typecheck": "bun run --filter @reef/shared --filter @reef/app --filter @reef/server --parallel typecheck",
    "test": "vitest run"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
