{
  "name": "coastal-clash",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "shared",
    "app",
    "server"
  ],
  "scripts": {
    "build": "bun run --filter @clash/app build",
    "start": "bun run --filter @clash/server start",
    "dev": "bun run --parallel --filter @clash/app --filter @clash/server dev",
    "typecheck": "bun run --sequential --filter @clash/shared --filter @clash/app --filter @clash/server typecheck",
    "test": "vitest run",
    "data": "tsx pipeline/miami-beach.ts && tsx pipeline/flood-by-area.ts",
    "data:flood-areas": "tsx pipeline/flood-by-area.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@turf/turf": "^7.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
