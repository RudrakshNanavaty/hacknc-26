# Copy to .env and fill in. Never commit .env or .env.local. Every key is optional: the game fails soft without it.
# Server loads only .env (tsx --env-file-if-exists=../.env). Vite may also read .env.local for VITE_* overrides.
# Gemini (server/src/ai/gemini.ts). Empty key = template narration only. Empty models = the defaults in code.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
# ElevenLabs (server/src/voice.ts). Empty voice ids = premade default voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BROADCAST=
ELEVENLABS_VOICE_NARRATOR=
# Tiger Data (Tiger Cloud) connection string, postgres://...?sslmode=require. Empty = matches kept in memory. Tables are prefixed cc_.
DATABASE_URL=
PORT=8787
VITE_SERVER_URL=http://localhost:8787
VITE_FEATURE_VOICE=true
VITE_FEATURE_AI=true
# Public base URL for room QR codes (our domain or a tunnel). Empty = this machine's LAN address.
PUBLIC_URL=
# Capital One Nessie bank mirror (server only; simulated accounts, never real money). Off unless NESSIE_ENABLED=true and a key is set.
# It copies each resolved round's ledger to fictional CoastalClash accounts; the game never waits on it. Get a key at https://prod.nessieisreal.com
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_ENABLED=false
