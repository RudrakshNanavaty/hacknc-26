# Copy to .env and fill in. Never commit .env. Every key is optional: the game fails soft without it.
# Gemini (server/src/ai/gemini.ts). Empty key = template narration only. Empty models = the defaults in code.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
# ElevenLabs (server/src/voice.ts). Empty voice ids = premade default voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BROADCAST=
ELEVENLABS_VOICE_NARRATOR=
# Tiger Data (Tiger Cloud) connection string, postgres://...?sslmode=require. Empty = matches kept in memory. Tables are prefixed cc_.
DATABASE_URL=
PORT=8787
VITE_SERVER_URL=http://localhost:8787
VITE_FEATURE_VOICE=true
VITE_FEATURE_AI=true
# Public base URL for room QR codes (our domain or a tunnel). Empty = this machine's LAN address.
PUBLIC_URL=
# Solana devnet civic record (server/src/solana). The 64-byte secret key as a JSON array; empty = fingerprints kept locally only.
SOLANA_PAYER_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
# Snowflake research corpus (server/src/stories.ts): account, programmatic access token, warehouse, role.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=
